{
  "name": "toolbox-pi-package",
  "version": "0.4.7",
  "description": "Small pi toolbox package with provider rate-limit handling and the /review command.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "changes.ts",
    "guidance.ts",
    "index.ts",
    "models.ts",
    "rate-limit.ts",
    "repo.ts",
    "review-progress.ts",
    "review-workflow.ts",
    "structured-output.ts",
    "subagent-runner.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "build": "echo 'No build step required'",
    "check": "node --test ./tests/*.test.ts",
    "test": "node --test ./tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
